```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python testing
.pytest_cache/
.coverage
coverage/

# Compiled Python
*.so
*.dylib
*.dll

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/
```